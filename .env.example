# Copy to .env for local development. These are the public (anon) values of the
# TA Searcher Supabase project; the same three are set on the Netlify site.
# The anon key has no table privileges: every read goes through row security
# for a signed-in user.
VITE_SUPABASE_PROJECT_ID="<project ref, e.g. abcdefghijklmnopqrst>"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key from Supabase project settings>"
VITE_SUPABASE_URL="https://<project ref>.supabase.co"
